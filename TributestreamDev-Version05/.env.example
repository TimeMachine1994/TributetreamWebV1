# WordPress API Configuration
VITE_WP_API_URL=https://your-wordpress-site.com/wp-json
VITE_WP_API_NAMESPACE=funeral/v2

# Authentication Configuration
VITE_JWT_AUTH_URL=https://your-wordpress-site.com/wp-json/jwt-auth/v1
VITE_AUTH_TOKEN_EXPIRY=604800 # 7 days in seconds

# CORS Configuration
VITE_CORS_ENABLED=true

# Application Configuration
VITE_APP_NAME=TributeStream
VITE_APP_URL=http://localhost:5173